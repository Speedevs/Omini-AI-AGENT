# ===== Pick ONE model provider =====
# anthropic | openai | grok | kimi | openrouter | ollama
OMNI_PROVIDER=anthropic

# Leave blank to use the default model for your provider
OMNI_MODEL=

# ----- Using several API keys (optional) -----
# Backups, in order: if the main provider fails (no credit, bad key, outage), Omni switches automatically.
# Only providers whose key is filled in below are used.
OMNI_FALLBACK=
#   example: OMNI_FALLBACK=kimi,grok,anthropic
# A different company's model for the blind judge makes its checks more independent. Optional.
OMNI_JUDGE_PROVIDER=
OMNI_JUDGE_MODEL=
#   example: OMNI_JUDGE_PROVIDER=grok
# Model for background reflection (a cheaper one is fine). Optional.
OMNI_REFLECT_PROVIDER=
OMNI_REFLECT_MODEL=

# ----- API keys (only fill the one you use) -----
# Anthropic (Claude):   https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=
# OpenAI:               https://platform.openai.com/api-keys
OPENAI_API_KEY=
# xAI Grok:             https://console.x.ai  -> API Keys
XAI_API_KEY=
# Kimi (Moonshot):     https://platform.moonshot.ai -> API Keys  (models: kimi-k3, kimi-k2.6)
MOONSHOT_API_KEY=
# OpenRouter (one key, hundreds of models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama runs models locally for free, no key: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1

# ----- Optional: better web search (free tier available) -----
# Without these, a free DuckDuckGo fallback is used (can be rate-limited)
TAVILY_API_KEY=
BRAVE_API_KEY=

# ----- Optional: get files (screen recordings, screenshots) on your phone via Telegram -----
# 1) In Telegram, message @BotFather, send /newbot, copy the token below.
# 2) Send any message to your new bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the number after "chat":{"id": into TELEGRAM_CHAT_ID. Omni can only send to this chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Browser control -----
# 1 = run the browser invisibly; blank = show the window so you can watch (recommended)
OMNI_BROWSER_HEADLESS=
# Extra Chrome flags, e.g. --start-maximized
OMNI_BROWSER_ARGS=

# ----- Behaviour -----
OMNI_MAX_STEPS=40
# Background reflection: every N seconds the agent's "inner voice" reviews progress in parallel (0 = off)
OMNI_REFLECT_EVERY=180
# Companion mode: Omni greets you and checks in after this many idle minutes (0 = off; or use --companion)
OMNI_COMPANION_MINUTES=0
OMNI_CHECKPOINT_EVERY=8
OMNI_CONTEXT_CHARS=300000
# Set to 1 to let the agent read/write files outside the workspace folder
OMNI_ALLOW_OUTSIDE_WORKSPACE=0
